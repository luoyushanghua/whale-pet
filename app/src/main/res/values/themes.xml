<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅蓝主题：弹窗、状态栏、通知都和主页一致 -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#EAF7FF</item>
        <item name="android:statusBarColor">#D9EEFF</item>
        <item name="android:navigationBarColor">#D9EEFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#1E88C7</item>
        <item name="android:colorPrimary">#5FB8FF</item>
        <item name="android:colorPrimaryDark">#1E88C7</item>
        <item name="android:textColorPrimary">#0E3552</item>
        <item name="android:textColorSecondary">#5B7E99</item>
        <item name="android:alertDialogTheme">@style/WhaleDialog</item>
    </style>

    <style name="WhaleDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#1E88C7</item>
        <item name="android:textColorPrimary">#0E3552</item>
        <item name="android:textColorSecondary">#5B7E99</item>
        <item name="android:windowBackground">@drawable/card_bg</item>
    </style>
    <style name="WhalePanel" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.18</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#1E88C7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
